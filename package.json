{
  "name": "mma-files",
  "version": "0.1.0",
  "private": true,
  "description": "MMA Files — Czech public fighting magazine powered by the BoardlessAI editorial engine.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/emit-week-chunks.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
